      "Mozilla/5.0 (Windows NT 10.0; Win64; x64; rv:102.0) Gecko/20100101 Firefox/102.0 Mypal/74.1.4",
    )
  assert result.family == "Mypal Browser"
  assert result.version
    == Some(uaparser.Version(major: "74", minor: Some("1"), patch: Some("4")))
}

